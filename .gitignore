/build*/
*.user
# Regenerable Ghidra database and run logs; see analysis/REPRODUCE.md to recreate.
/analysis/ghidra_project/
/analysis/ghidra_*.log
__pycache__/
*.pyc
# Vendor material stays on this machine only: the vendor's Windows driver files and what was derived from
# them by decompiling and disassembling. Not ours to redistribute; see the Licence section of the README.
/vendor/
/analysis/decompiled/
/analysis/disassembly/
# makepkg's working directories and output, from `cd packaging/arch && makepkg -f`. src/tree is a full
# copy of the working tree, so committing it would duplicate the repository inside itself.
/packaging/arch/src/
/packaging/arch/pkg/
/packaging/arch/*.pkg.tar.*
